PORT=3001
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>"
# Comma-separated list of allowed browser origins (a single value also works).
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3001

# How many reverse proxies sit in front of the app. Production is 1 (Nginx on
# the same host); raise it if another proxy is put in front (e.g. turning on
# Cloudflare's orange cloud makes it 2). Getting this wrong makes every
# request look like it comes from the same IP, which collapses all rate
# limiters into one shared bucket. Leave unset locally.
TRUST_PROXY_HOPS=1


# JWT — two separate secrets required
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudflare R2  
R2_BUCKET=foundit-images

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Public base URL of the bucket (r2.dev or custom domain, no trailing slash).
# Set it to serve stable, cacheable image URLs. Leave empty to fall back to a
# presigned GET URL per image.
R2_PUBLIC_BASE_URL=
# Lifetime of those presigned GET URLs, in seconds. Only used when
# R2_PUBLIC_BASE_URL is empty. Default 86400 (24h); capped at 604800 (7 days,
# the SigV4 maximum).
R2_SIGNED_URL_TTL_SECONDS=

# OpenRouter embeddings for semantic matching. If unset the backend falls back
# to a meaningless local hash embedding and logs a warning at startup; matching
# still responds but the ranking is close to random.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Multimodal image embeddings for AI Matches photo similarity.
OPENROUTER_IMAGE_EMBEDDING_MODEL=

# How many missing item embeddings one match-suggestion request may compute
# inline (default 25) and how many of those calls run in parallel (default 4).
# Items beyond the cap are still scored, using the local fallback embedding.
# Run `pnpm backfill:embeddings` to prime existing rows instead.
MATCH_INLINE_EMBEDDING_LIMIT=25
MATCH_EMBEDDING_CONCURRENCY=4
